# Copy into Streamlit Cloud -> App -> Settings -> Secrets (or to .streamlit/secrets.toml locally).
# NEVER commit the real values.

# Supabase -> Project -> Connect -> "Session pooler" connection string (IPv4 compatible).
DATABASE_URL = "postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# 64 hex characters. Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep it forever: changing it makes every existing record fail signature verification.
DEVICE_HMAC_KEY = "REPLACE_WITH_64_HEX_CHARS"

# First administrator, created automatically only if the users table is empty.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "CHANGE-ME-strong-password"
